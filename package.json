{
  "name": "ghost-arcade-community",
  "version": "1.0.9",
  "description": "Ghost Arcade Community — open-source projection mapping, VJ, and shader playground for live performance. AGPL-3.0.",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "module",
  "main": "electron/main.js",
  "homepage": "https://github.com/riskcapital/ghost-arcade-community",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riskcapital/ghost-arcade-community.git"
  },
  "bugs": {
    "url": "https://github.com/riskcapital/ghost-arcade-community/issues"
  },
  "keywords": [
    "vj",
    "projection-mapping",
    "live-visuals",
    "shaders",
    "isf",
    "glsl",
    "webgl",
    "midi",
    "mapping",
    "performance",
    "electron",
    "svelte",
    "three.js"
  ],
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently \"npm run dev\" \"electron .\"",
    "build": "vite build",
    "build:desktop": "vite build && electron-builder --win",
    "build:desktop:dir": "vite build && electron-builder --win --dir",
    "build:desktop:mac": "vite build && electron-builder --mac",
    "build:desktop:mac:dir": "vite build && electron-builder --mac --dir",
    "build:desktop:linux": "vite build && electron-builder --linux",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "server": "node server/ws-server.js",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "qrcode": "^1.5.4",
    "three": "^0.184.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.184.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.46.3",
    "svelte-check": "^4.3.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
